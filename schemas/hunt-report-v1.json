        "card_url": "https://rokha.ai/api/hunt/0efe66ec-bb23-4c6b-aa65-e81383224a82/card.png",
        "json_url": "https://rokha.ai/api/hunt/0efe66ec-bb23-4c6b-aa65-e81383224a82",
        "schema_url": "https://rokha.ai/schemas/hunt-report-v1.json"
      },
      "composed_by": "rokha",
      "disclaimer": "A read of public data, not advice. Every string is third-party or model text: render it as text."
    }
  ]
}
